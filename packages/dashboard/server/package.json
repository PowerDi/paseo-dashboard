{
  "name": "@getpaseo/dashboard-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "types": "./src/app.ts",
      "source": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "source": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./lib/event-bus": {
      "types": "./src/lib/event-bus.ts",
      "source": "./src/lib/event-bus.ts",
      "default": "./src/lib/event-bus.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.0",
    "@getpaseo/dashboard-shared": "*",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "pino": "^9.0.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
